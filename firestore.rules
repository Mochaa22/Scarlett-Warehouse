rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // === GLOBAL PRIMITIVES ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedSuperAdmin() {
      return isVerified() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'ferdiputraa793@gmail.com';
    }

    function isSuperAdmin() {
      return isVerified() && (
        isBootstrappedSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'owner'])
      );
    }

    function isAdmin() {
      return isVerified() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'owner'])
      );
    }

    function isValidMemberEmails(data) {
      return !data.keys().hasAny(['memberEmails']) || (
        data.memberEmails is list &&
        data.memberEmails.size() <= 50 &&
        (data.memberEmails.size() == 0 || (data.memberEmails[0] is string && data.memberEmails[0].size() <= 254))
      );
    }

    function canListTenantResource() {
      return isVerified() && (
        resource.data.ownerId == request.auth.uid ||
        isBootstrappedSuperAdmin() ||
        (
          request.auth.token.email is string &&
          resource.data.keys().hasAny(['memberEmails']) &&
          resource.data.memberEmails is list &&
          request.auth.token.email.lower() in resource.data.memberEmails
        )
      );
    }

    function isAssignedTeamMember() {
      return isVerified() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/roleAssignments/$(request.auth.token.email.lower()));
    }

    function isWarehouseOwner(warehouseId) {
      return isVerified() &&
        exists(/databases/$(database)/documents/warehouses/$(warehouseId)) &&
        get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.ownerId == request.auth.uid;
    }

    function isWarehouseTeamOrOwner(warehouseId) {
      let wh = get(/databases/$(database)/documents/warehouses/$(warehouseId)).data;
      return isVerified() &&
        exists(/databases/$(database)/documents/warehouses/$(warehouseId)) && (
          wh.ownerId == request.auth.uid ||
          isAdmin() ||
          (
            isAssignedTeamMember() &&
            wh.keys().hasAny(['memberEmails']) &&
            wh.memberEmails is list &&
            request.auth.token.email.lower() in wh.memberEmails
          )
        );
    }

    function allowsAssignedWarehouse(warehouseId) {
      let email = request.auth.token.email.lower();
      let assignmentPath = /databases/$(database)/documents/roleAssignments/$(email);
      return !exists(assignmentPath) ||
        get(assignmentPath).data.get('warehouseId', warehouseId) == warehouseId;
    }

    // === VALIDATION BLUEPRINTS ===
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role in ['stockkeeper', 'admin', 'super_admin', 'owner']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoleAssignment(data, assignmentId) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'assignedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'assignedByUid', 'createdAt', 'updatedAt', 'warehouseId', 'warehouseName'])
        && data.id is string && data.id.size() >= 3 && data.id.size() <= 254
        && (isValidId(data.id) || data.id == data.email)
        && (!data.keys().hasAny(['warehouseId', 'warehouseName']) ||
          (data.id == data.email && data.role == 'stockkeeper' &&
            isValidId(data.warehouseId) && data.warehouseName is string &&
            data.warehouseName.size() > 0 && data.warehouseName.size() <= 120))
        && data.id == assignmentId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email == data.email.lower()
        && data.displayName is string && data.displayName.size() <= 120
        && data.role is string && data.role in ['stockkeeper', 'admin', 'super_admin']
        && isValidId(data.assignedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && isValidId(data.uid)
        && data.uid == adminUid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.grantedAt is timestamp;
    }

    function isValidPinConfig(data, configId) {
      return data.keys().hasAll(['id', 'ownerId', 'adminHash', 'superAdminHash', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'adminHash', 'superAdminHash', 'updatedBy', 'memberEmails', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == configId
        && isValidId(data.ownerId)
        && data.adminHash is string && data.adminHash.size() >= 10 && data.adminHash.size() <= 256
        && data.superAdminHash is string && data.superAdminHash.size() >= 10 && data.superAdminHash.size() <= 256
        && data.updatedBy is string && data.updatedBy.size() <= 254
        && isValidMemberEmails(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWarehouse(data, warehouseId) {
      return data.keys().hasAll(['id', 'ownerId', 'kode', 'nama', 'cutoff', 'minStock', 'mode', 'coverDays', 'expMonths', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'kode', 'nama', 'legacy', 'order', 'cutoff', 'minStock', 'mode', 'coverDays', 'expMonths', 'memberEmails', 'createdAt', 'updatedAt'])
        && (!data.keys().hasAny(['legacy']) || data.legacy is bool)
        && (!data.keys().hasAny(['order']) || (data.order is number && data.order >= 0))
        && isValidMemberEmails(data)
        && isValidId(data.id)
        && data.id == warehouseId
        && isValidId(data.ownerId)
        && data.kode is string && data.kode.size() >= 1 && data.kode.size() <= 32
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.cutoff is string && data.cutoff.size() <= 32
        && data.minStock is number && data.minStock >= 0
        && data.mode is string && data.mode in ['mutasi', 'all']
        && data.coverDays is number && data.coverDays >= 1
        && data.expMonths is number && data.expMonths >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogItem(data, warehouseId, itemId) {
      return data.keys().hasAll(['id', 'warehouseId', 'ownerId', 'kind', 'barcode', 'sku', 'nama', 'kategori', 'lok', 'qty', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'warehouseId', 'ownerId', 'kind', 'barcode', 'sku', 'nama', 'kategori', 'lok', 'qty', 'memberEmails', 'createdAt', 'updatedAt'])
        && isValidMemberEmails(data)
        && isValidId(data.id)
        && data.id == itemId
        && isValidId(data.warehouseId)
        && data.warehouseId == warehouseId
        && isValidId(data.ownerId)
        && data.kind is string && data.kind in ['master', 'lokasi', 'opening', 'allstock']
        && data.barcode is string && data.barcode.size() <= 128
        && data.sku is string && data.sku.size() <= 128
        && data.nama is string && data.nama.size() <= 256
        && data.kategori is string && data.kategori.size() <= 128
        && data.lok is string && data.lok.size() <= 128
        && data.qty is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, warehouseId, txId) {
      return data.keys().hasAll(['id', 'warehouseId', 'ownerId', 'txType', 'tgl', 'barcode', 'sku', 'nama', 'lok', 'dari', 'ke', 'qty', 'inboundQty', 'sistem', 'fisik', 'selisih', 'exp', 'batch', 'ket', 'by', 'n', 'ancanthoDone', 'ancanthoBy', 'ancanthoKet', 'ancanthoAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'warehouseId', 'ownerId', 'txType', 'tgl', 'barcode', 'sku', 'nama', 'lok', 'dari', 'ke', 'qty', 'inboundQty', 'sistem', 'fisik', 'selisih', 'exp', 'batch', 'ket', 'by', 'n', 'ancanthoDone', 'ancanthoBy', 'ancanthoKet', 'ancanthoAt', 'createdAt', 'updatedAt', 'supplier', 'driver', 'noPlat', 'noDoc', 'pairId', 'partnerWhId', 'defectRefId', 'memberEmails'])
        && isValidMemberEmails(data)
        && (!data.keys().hasAny(['supplier']) || (data.supplier is string && data.supplier.size() <= 128))
        && (!data.keys().hasAny(['driver']) || (data.driver is string && data.driver.size() <= 128))
        && (!data.keys().hasAny(['noPlat']) || (data.noPlat is string && data.noPlat.size() <= 128))
        && (!data.keys().hasAny(['noDoc']) || (data.noDoc is string && data.noDoc.size() <= 128))
        && (!data.keys().hasAny(['pairId']) || (data.pairId is string && data.pairId.size() <= 128))
        && (!data.keys().hasAny(['partnerWhId']) || (data.partnerWhId is string && data.partnerWhId.size() <= 128))
        && (!data.keys().hasAny(['defectRefId']) || (data.defectRefId is string && data.defectRefId.size() <= 128))
        && isValidId(data.id)
        && data.id == txId
        && isValidId(data.warehouseId)
        && data.warehouseId == warehouseId
        && isValidId(data.ownerId)
        && data.txType is string && data.txType in ['masuk', 'keluar', 'pindah', 'opname']
        && data.tgl is string && data.tgl.size() <= 32
        && data.barcode is string && data.barcode.size() <= 128
        && data.sku is string && data.sku.size() <= 128
        && data.nama is string && data.nama.size() <= 256
        && data.lok is string && data.lok.size() <= 128
        && data.dari is string && data.dari.size() <= 128
        && data.ke is string && data.ke.size() <= 128
        && data.qty is number
        && (data.inboundQty == null || data.inboundQty is number)
        && data.sistem is number
        && data.fisik is number
        && data.selisih is number
        && data.exp is string && data.exp.size() <= 32
        && data.batch is string && data.batch.size() <= 128
        && data.ket is string && data.ket.size() <= 500
        && data.by is string && data.by.size() <= 120
        && data.n is number
        && data.ancanthoDone is bool
        && data.ancanthoBy is string && data.ancanthoBy.size() <= 120
        && data.ancanthoKet is string && data.ancanthoKet.size() <= 500
        && data.ancanthoAt is string && data.ancanthoAt.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBatch(data, warehouseId, batchId) {
      return data.keys().hasAll(['id', 'warehouseId', 'ownerId', 'masukId', 'tglMasuk', 'lok', 'barcode', 'sku', 'nama', 'batch', 'exp', 'qty', 'status', 'ket', 'by', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'warehouseId', 'ownerId', 'masukId', 'tglMasuk', 'lok', 'barcode', 'sku', 'nama', 'batch', 'exp', 'qty', 'status', 'ket', 'by', 'memberEmails', 'createdAt', 'updatedAt'])
        && isValidMemberEmails(data)
        && isValidId(data.id)
        && data.id == batchId
        && isValidId(data.warehouseId)
        && data.warehouseId == warehouseId
        && isValidId(data.ownerId)
        && data.masukId is string && data.masukId.size() <= 128
        && data.tglMasuk is string && data.tglMasuk.size() <= 32
        && data.lok is string && data.lok.size() <= 128
        && data.barcode is string && data.barcode.size() <= 128
        && data.sku is string && data.sku.size() <= 128
        && data.nama is string && data.nama.size() <= 256
        && data.batch is string && data.batch.size() <= 128
        && data.exp is string && data.exp.size() <= 32
        && data.qty is number && data.qty >= 0
        && data.status is string && data.status in ['AKTIF', 'KARANTINA', 'SELESAI', 'HABIS']
        && data.ket is string && data.ket.size() <= 500
        && data.by is string && data.by.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDefect(data, warehouseId, defectId) {
      return data.keys().hasAll(['id', 'warehouseId', 'ownerId', 'tgl', 'barcode', 'sku', 'nama', 'lok', 'kategori', 'qty', 'ket', 'by', 'status', 'tindakLanjut', 'resolvedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'warehouseId', 'ownerId', 'tgl', 'barcode', 'sku', 'nama', 'lok', 'kategori', 'qty', 'ket', 'by', 'status', 'tindakLanjut', 'resolvedAt', 'sumber', 'batch', 'exp', 'potongStok', 'n', 'outId', 'memberEmails', 'createdAt', 'updatedAt'])
        && isValidMemberEmails(data)
        && (!data.keys().hasAny(['sumber']) || (data.sumber is string && data.sumber.size() <= 64))
        && (!data.keys().hasAny(['batch']) || (data.batch is string && data.batch.size() <= 128))
        && (!data.keys().hasAny(['exp']) || (data.exp is string && data.exp.size() <= 32))
        && (!data.keys().hasAny(['potongStok']) || data.potongStok is bool)
        && (!data.keys().hasAny(['n']) || data.n is number)
        && (!data.keys().hasAny(['outId']) || (data.outId is string && data.outId.size() <= 128))
        && isValidId(data.id)
        && data.id == defectId
        && isValidId(data.warehouseId)
        && data.warehouseId == warehouseId
        && isValidId(data.ownerId)
        && data.tgl is string && data.tgl.size() <= 32
        && data.barcode is string && data.barcode.size() <= 128
        && data.sku is string && data.sku.size() <= 128
        && data.nama is string && data.nama.size() <= 256
        && data.lok is string && data.lok.size() <= 128
        && data.kategori is string && data.kategori.size() <= 128
        && data.qty is number && data.qty >= 0
        && data.ket is string && data.ket.size() <= 500
        && data.by is string && data.by.size() <= 120
        && data.status is string && data.status in ['KARANTINA', 'RETUR', 'RETUR SUPPLIER', 'MUSNAH', 'REPACK']
        && data.tindakLanjut is string && data.tindakLanjut.size() <= 256
        && data.resolvedAt is string && data.resolvedAt.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCycleSession(data, warehouseId, sessionId) {
      return data.keys().hasAll(['id', 'warehouseId', 'ownerId', 'tgl', 'picAdmin', 'picField', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'warehouseId', 'ownerId', 'tgl', 'picAdmin', 'picField', 'status', 'notes', 'judul', 'blindCount', 'closedAt', 'createdBy', 'createdAtStr', 'memberEmails', 'createdAt', 'updatedAt'])
        && isValidMemberEmails(data)
        && (!data.keys().hasAny(['judul']) || (data.judul is string && data.judul.size() <= 160))
        && (!data.keys().hasAny(['blindCount']) || data.blindCount is bool)
        && (!data.keys().hasAny(['closedAt']) || (data.closedAt is string && data.closedAt.size() <= 32))
        && (!data.keys().hasAny(['createdBy']) || (data.createdBy is string && data.createdBy.size() <= 120))
        && (!data.keys().hasAny(['createdAtStr']) || (data.createdAtStr is string && data.createdAtStr.size() <= 64))
        && isValidId(data.id)
        && data.id == sessionId
        && isValidId(data.warehouseId)
        && data.warehouseId == warehouseId
        && isValidId(data.ownerId)
        && data.tgl is string && data.tgl.size() <= 32
        && data.picAdmin is string && data.picAdmin.size() <= 120
        && data.picField is string && data.picField.size() <= 120
        && data.status is string && data.status in ['OPEN', 'AKTIF', 'SELESAI']
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCycleLine(data, warehouseId, sessionId, lineId) {
      return data.keys().hasAll(['id', 'warehouseId', 'sessionId', 'ownerId', 'sku', 'barcode', 'nama', 'lok', 'sysQty', 'prevDiff', 'physQty', 'countedBy', 'countedAt', 'notes', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'warehouseId', 'sessionId', 'ownerId', 'sku', 'barcode', 'nama', 'lok', 'kategori', 'assignedTo', 'sysQty', 'prevDiff', 'physQty', 'countedBy', 'countedAt', 'notes', 'status', 'memberEmails', 'createdAt', 'updatedAt'])
        && isValidMemberEmails(data)
        && (!data.keys().hasAny(['kategori']) || (data.kategori is string && data.kategori.size() <= 128))
        && (!data.keys().hasAny(['assignedTo']) || (data.assignedTo is string && data.assignedTo.size() <= 120))
        && isValidId(data.id)
        && data.id == lineId
        && isValidId(data.warehouseId)
        && data.warehouseId == warehouseId
        && isValidId(data.sessionId)
        && data.sessionId == sessionId
        && isValidId(data.ownerId)
        && data.sku is string && data.sku.size() <= 128
        && data.barcode is string && data.barcode.size() <= 128
        && data.nama is string && data.nama.size() <= 256
        && data.lok is string && data.lok.size() <= 128
        && data.sysQty is number
        && (data.prevDiff == null || data.prevDiff is number)
        && (data.physQty == null || data.physQty is number)
        && data.countedBy is string && data.countedBy.size() <= 120
        && data.countedAt is string && data.countedAt.size() <= 32
        && data.notes is string && data.notes.size() <= 500
        && data.status is string && data.status in ['PENDING', 'COUNTED', 'VERIFIED', 'MENUNGGU', 'TERHITUNG', 'TERVERIFIKASI']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInboundEntry(data, warehouseId, entryId) {
      return data.keys().hasAll(['id', 'warehouseId', 'ownerId', 'tgl', 'supplier', 'driver', 'noPlat', 'noDoc', 'barcode', 'sku', 'nama', 'exp', 'qty', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'warehouseId', 'ownerId', 'tgl', 'supplier', 'driver', 'noPlat', 'noDoc', 'barcode', 'sku', 'nama', 'exp', 'qty', 'memberEmails', 'createdAt', 'updatedAt'])
        && isValidMemberEmails(data)
        && isValidId(data.id)
        && data.id == entryId
        && isValidId(data.warehouseId)
        && data.warehouseId == warehouseId
        && isValidId(data.ownerId)
        && data.tgl is string && data.tgl.size() <= 32
        && data.supplier is string && data.supplier.size() <= 128
        && data.driver is string && data.driver.size() <= 128
        && data.noPlat is string && data.noPlat.size() <= 128
        && data.noDoc is string && data.noDoc.size() <= 128
        && data.barcode is string && data.barcode.size() <= 128
        && data.sku is string && data.sku.size() <= 128
        && data.nama is string && data.nama.size() <= 256
        && data.exp is string && data.exp.size() <= 32
        && data.qty is number && data.qty >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // === CONNECTION HEALTH CHECK ===
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // === ADMINS DIRECTORY ===
    match /admins/{adminUid} {
      allow get: if isVerified() && isValidId(adminUid) && (request.auth.uid == adminUid || isSuperAdmin());
      allow list: if false;
      allow create, update, delete: if isSuperAdmin() && isValidId(adminUid) && isValidAdminRecord(incoming(), adminUid);
    }

    // === ROLE ASSIGNMENTS (SUPER ADMIN TEAM DIRECTORY) ===
    match /roleAssignments/{assignmentId} {
      allow get: if isVerified() && (isSuperAdmin() || assignmentId == request.auth.token.email.lower() || existing().email == request.auth.token.email.lower());
      allow list: if isVerified() && (isBootstrappedSuperAdmin() || resource.data.email == request.auth.token.email.lower());
      allow create: if isSuperAdmin()
        && isValidRoleAssignment(incoming(), assignmentId)
        && incoming().assignedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSuperAdmin()
        && isValidRoleAssignment(incoming(), assignmentId)
        && incoming().id == existing().id
        && incoming().assignedByUid == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    // === PIN CONFIGS (CLOUD PERSISTENCE FOR ADMIN & SUPER ADMIN PINS) ===
    match /pinConfigs/{configId} {
      allow get: if isVerified() && isValidId(configId) && (
        configId == request.auth.uid ||
        isSuperAdmin() ||
        (
          resource != null && (
            existing().ownerId == request.auth.uid ||
            (
              request.auth.token.email is string &&
              existing().keys().hasAny(['memberEmails']) &&
              existing().memberEmails is list &&
              request.auth.token.email.lower() in existing().memberEmails
            )
          )
        )
      );
      allow list: if canListTenantResource();
      allow create: if isVerified()
        && isValidId(configId)
        && isValidPinConfig(incoming(), configId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(configId)
        && isValidPinConfig(incoming(), configId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().ownerId == request.auth.uid || isSuperAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['adminHash', 'superAdminHash', 'updatedBy', 'memberEmails', 'updatedAt']);
      allow delete: if isVerified() && isValidId(configId) && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    // === USERS (PII ISOLATED) ===
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedSuperAdmin());
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'stockkeeper'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );
      allow delete: if isSuperAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if isVerified() && isValidId(docId) && (request.auth.uid == userId || isSuperAdmin());
        allow list: if false;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && (request.auth.uid == userId || isSuperAdmin())
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isSuperAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    // === WAREHOUSES & SUBCOLLECTIONS ===
    match /warehouses/{warehouseId} {
      allow get: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && (
        existing().ownerId == request.auth.uid ||
        isAdmin() ||
        (
          isAssignedTeamMember() &&
          existing().keys().hasAny(['memberEmails']) &&
          existing().memberEmails is list &&
          request.auth.token.email.lower() in existing().memberEmails
        )
      );
      allow list: if canListTenantResource();
      allow create: if isVerified() && allowsAssignedWarehouse(warehouseId)
        && isValidId(warehouseId)
        && isValidWarehouse(incoming(), warehouseId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && allowsAssignedWarehouse(warehouseId)
        && isValidId(warehouseId)
        && isValidWarehouse(incoming(), warehouseId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['kode', 'nama', 'legacy', 'order', 'cutoff', 'minStock', 'mode', 'coverDays', 'expMonths', 'memberEmails', 'updatedAt'])
          )
        );
      allow delete: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && (existing().ownerId == request.auth.uid || isAdmin());

      match /catalog/{itemId} {
        allow get: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(itemId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
        allow list: if canListTenantResource();
        allow create: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(itemId)
          && (isWarehouseOwner(warehouseId) || isWarehouseTeamOrOwner(warehouseId))
          && isValidCatalogItem(incoming(), warehouseId, itemId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(itemId)
          && isValidCatalogItem(incoming(), warehouseId, itemId)
          && incoming().id == existing().id
          && incoming().warehouseId == existing().warehouseId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['barcode', 'sku', 'nama', 'kategori', 'lok', 'qty', 'memberEmails', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(itemId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
      }

      match /transactions/{txId} {
        allow get: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(txId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
        allow list: if canListTenantResource();
        allow create: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(txId)
          && (isWarehouseOwner(warehouseId) || isWarehouseTeamOrOwner(warehouseId))
          && isValidTransaction(incoming(), warehouseId, txId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(txId)
          && isValidTransaction(incoming(), warehouseId, txId)
          && incoming().id == existing().id
          && incoming().warehouseId == existing().warehouseId
          && incoming().ownerId == existing().ownerId
          && incoming().txType == existing().txType
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId)) &&
              existing().ancanthoDone == false &&
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['by', 'tgl', 'supplier', 'driver', 'noPlat', 'noDoc', 'pairId', 'partnerWhId', 'defectRefId', 'barcode', 'sku', 'nama', 'lok', 'dari', 'ke', 'exp', 'batch', 'qty', 'ket', 'memberEmails', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['inboundQty', 'ancanthoDone', 'ancanthoBy', 'ancanthoKet', 'ancanthoAt', 'memberEmails', 'updatedAt'])
              )
            )
          );
        allow delete: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(txId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
      }

      match /batches/{batchId} {
        allow get: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(batchId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
        allow list: if canListTenantResource();
        allow create: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(batchId)
          && (isWarehouseOwner(warehouseId) || isWarehouseTeamOrOwner(warehouseId))
          && isValidBatch(incoming(), warehouseId, batchId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(batchId)
          && isValidBatch(incoming(), warehouseId, batchId)
          && incoming().id == existing().id
          && incoming().warehouseId == existing().warehouseId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId)) &&
              existing().status != 'SELESAI' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['tglMasuk', 'lok', 'barcode', 'sku', 'nama', 'batch', 'exp', 'qty', 'status', 'ket', 'by', 'memberEmails', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(batchId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
      }

      match /defects/{defectId} {
        allow get: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(defectId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
        allow list: if canListTenantResource();
        allow create: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(defectId)
          && (isWarehouseOwner(warehouseId) || isWarehouseTeamOrOwner(warehouseId))
          && isValidDefect(incoming(), warehouseId, defectId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(defectId)
          && isValidDefect(incoming(), warehouseId, defectId)
          && incoming().id == existing().id
          && incoming().warehouseId == existing().warehouseId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId)) &&
              existing().status in ['KARANTINA', 'REPACK'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'tindakLanjut', 'resolvedAt', 'ket', 'qty', 'sumber', 'batch', 'exp', 'potongStok', 'n', 'outId', 'memberEmails', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(defectId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
      }

      match /cycleCounts/{sessionId} {
        allow get: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(sessionId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
        allow list: if canListTenantResource();
        allow create: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(sessionId)
          && (isWarehouseOwner(warehouseId) || isWarehouseTeamOrOwner(warehouseId))
          && isValidCycleSession(incoming(), warehouseId, sessionId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(sessionId)
          && isValidCycleSession(incoming(), warehouseId, sessionId)
          && incoming().id == existing().id
          && incoming().warehouseId == existing().warehouseId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId)) &&
              existing().status != 'SELESAI' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['picAdmin', 'picField', 'status', 'notes', 'judul', 'blindCount', 'closedAt', 'createdBy', 'createdAtStr', 'memberEmails', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(sessionId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));

        match /lines/{lineId} {
          allow get: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(sessionId) && isValidId(lineId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
          allow list: if canListTenantResource();
          allow create: if isVerified() && allowsAssignedWarehouse(warehouseId)
            && isValidId(warehouseId)
            && isValidId(sessionId)
            && isValidId(lineId)
            && exists(/databases/$(database)/documents/warehouses/$(warehouseId)/cycleCounts/$(sessionId))
            && (get(/databases/$(database)/documents/warehouses/$(warehouseId)/cycleCounts/$(sessionId)).data.ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId))
            && isValidCycleLine(incoming(), warehouseId, sessionId, lineId)
            && incoming().ownerId == request.auth.uid
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time;
          allow update: if isVerified() && allowsAssignedWarehouse(warehouseId)
            && isValidId(warehouseId)
            && isValidId(sessionId)
            && isValidId(lineId)
            && isValidCycleLine(incoming(), warehouseId, sessionId, lineId)
            && incoming().id == existing().id
            && incoming().warehouseId == existing().warehouseId
            && incoming().sessionId == existing().sessionId
            && incoming().ownerId == existing().ownerId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              isAdmin() ||
              (
                (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId)) &&
                !(existing().status in ['VERIFIED', 'TERVERIFIKASI']) &&
                incoming().diff(existing()).affectedKeys().hasOnly(['physQty', 'countedBy', 'countedAt', 'notes', 'status', 'kategori', 'assignedTo', 'memberEmails', 'updatedAt'])
              )
            );
          allow delete: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(sessionId) && isValidId(lineId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
        }
      }

      match /inboundRegister/{entryId} {
        allow get: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(entryId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
        allow list: if canListTenantResource();
        allow create: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(entryId)
          && (isWarehouseOwner(warehouseId) || isWarehouseTeamOrOwner(warehouseId))
          && isValidInboundEntry(incoming(), warehouseId, entryId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && allowsAssignedWarehouse(warehouseId)
          && isValidId(warehouseId)
          && isValidId(entryId)
          && isValidInboundEntry(incoming(), warehouseId, entryId)
          && incoming().id == existing().id
          && incoming().warehouseId == existing().warehouseId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['tgl', 'supplier', 'driver', 'noPlat', 'noDoc', 'barcode', 'sku', 'nama', 'exp', 'qty', 'memberEmails', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && allowsAssignedWarehouse(warehouseId) && isValidId(warehouseId) && isValidId(entryId) && (existing().ownerId == request.auth.uid || isWarehouseTeamOrOwner(warehouseId));
      }
    }
  }
}
